{
  "name": "OctTree",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "server"
      }
    },
    "StarterPlayer":{
      "StarterPlayerScripts":{
        "Client":{
          "$path":"client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
      
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}